#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "🚀 Running pre-push checks for FRONTEND..."
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

# Step 1: Check environment variables
echo "\n🔐 Step 1: Checking environment variables..."
if [ ! -f ".env.production" ]; then
  echo "⚠️  Warning: .env.production file not found"
fi

required_vars=("VITE_API_URL" "VITE_CLOUDINARY_CLOUD_NAME")
for var in "${required_vars[@]}"; do
  if ! grep -q "^${var}=" .env.production 2>/dev/null; then
    echo "❌ Missing required env var: ${var}"
    exit 1
  fi
done
echo "✅ Environment variables validated!"

# Step 2: Lint check
echo "\n📝 Step 2: Running ESLint..."
pnpm run lint
if [ $? -ne 0 ]; then
  echo "❌ Linting failed! Run 'pnpm run lint:fix' to auto-fix."
  exit 1
fi
echo "✅ Linting passed!"

# Step 3: TypeScript type check
echo "\n🔍 Step 3: TypeScript type checking..."
npx tsc --noEmit
if [ $? -ne 0 ]; then
  echo "❌ TypeScript type check failed! Fix type errors."
  exit 1
fi
echo "✅ Type check passed!"

# Step 4: Build
echo "\n🔨 Step 4: Building frontend..."
pnpm run build
if [ $? -ne 0 ]; then
  echo "❌ Build failed! Fix build errors before pushing."
  exit 1
fi
echo "✅ Build successful!"

# Step 5: Check bundle size
echo "\n📦 Step 5: Checking bundle size..."
bundle_size=$(du -sh dist | cut -f1)
echo "   Bundle size: $bundle_size"
# Optional: Add size limit check
# if [ $(du -s dist | cut -f1) -gt 5000 ]; then
#   echo "⚠️  Warning: Bundle size exceeds 5MB"
# fi

# Step 6: Check for console.logs (optional)
echo "\n🔍 Step 6: Checking for console statements..."
if grep -r "console\." src --include="*.tsx" --include="*.ts" | grep -v "// @debug"; then
  echo "⚠️  Warning: Found console statements in source code"
  echo "   Consider removing them or adding // @debug comment to ignore"
fi

# Step 7: Check for TODO/FIXME (optional)
echo "\n📝 Step 7: Checking for unresolved TODOs..."
todos=$(grep -r "TODO\|FIXME" src --include="*.tsx" --include="*.ts" | wc -l | xargs)
if [ "$todos" -gt 0 ]; then
  echo "⚠️  Found $todos TODO/FIXME comments"
  grep -r "TODO\|FIXME" src --include="*.tsx" --include="*.ts" | head -5
fi

echo "\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "✅ All pre-push checks passed for FRONTEND!"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n"